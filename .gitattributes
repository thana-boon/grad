# Auto-detect text files and normalize line endings
* text=auto

# JS/JSX/JSON — ใช้ LF
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.env   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# ไฟล์ที่รันใน container ลินุกซ์ — ต้องเป็น LF เท่านั้น
# ถ้าโดนเช็คเอาต์เป็น CRLF บนวินโดวส์แล้ว commit ขึ้นไป คอนเทนเนอร์จะพังทันทีที่สตาร์ท
# ด้วย error กำกวมแบบ "no such file or directory" (จริง ๆ คือ \r ติดท้ายบรรทัด shebang)
*.sh          text eol=lf
Dockerfile    text eol=lf
.dockerignore text eol=lf
.env.example  text eol=lf

# Binary files
*.png   binary
*.jpg   binary
*.svg   binary

# ไฟล์ seed ที่บีบอัด (database/seeds/catalog.json.gz)
# ชื่อลงท้าย .gz ไม่โดน *.json จับ จึงเหลือแค่ `* text=auto` คลุมอยู่ — ปกติ git
# ตรวจเจอ NUL แล้วถือเป็น binary เอง แต่ประกาศไว้ตรง ๆ ปลอดภัยกว่า เพราะถ้าวันไหน
# โดน normalize บรรทัด ไฟล์ .gz จะเสียแบบเงียบ ๆ แล้วไปโผล่เป็น seed ล้มตอนสตาร์ท
*.gz    binary
